NODE_ENV=development
PORT=3003
LOG_LEVEL=info
CORS_ORIGINS=http://localhost:3000

# Project PostgreSQL cluster: `pnpm --filter @ig/api db:local init` (port 5434, no Docker needed).
# With Docker instead: postgresql://instagram:instagram_dev@localhost:5432/instagram
DATABASE_URL=postgresql://instagram:instagram_dev@localhost:5434/instagram

# Generate: node -e "console.log(crypto.randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=change-me-to-a-random-string-of-at-least-32-chars
# SMTP_URL=smtp://localhost:1025
